---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>sleeping hub</h1>
				<p class="tagline">大模型 infra —— 推理引擎、KV Cache、调度与底层系统</p>
				<p class="bio">
					我是 <a href="https://github.com/echoes1984">echoes1984</a>。这里记录我在大模型基础设施方向的学习与实践：
					推理框架（vLLM / SGLang）的内部机制、性能优化，以及踩过的坑。
				</p>
			</section>
			<section class="posts">
				<h2>最近文章</h2>
				<ul>
					{
						(await getCollection('blog'))
							.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
							.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
								</li>
							))
					}
				</ul>
				<p class="all-posts">
					<a href="/blog">全部文章 →</a>
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		text-align: center;
		margin: 3em 0 3.5em;
	}
	.intro h1 {
		font-size: 3.2em;
		font-family: ui-monospace, 'SF Mono', Consolas, monospace;
		letter-spacing: 0.08em;
		text-transform: lowercase;
		color: #fff;
		text-shadow: 0 0 10px rgba(0, 240, 255, 0.8), 0 0 32px rgba(0, 240, 255, 0.4),
			0 0 60px rgba(255, 46, 151, 0.3);
		animation: flicker 6s infinite;
	}
	@keyframes flicker {
		0%, 91%, 94%, 98%, 100% {
			opacity: 1;
		}
		92%, 93% {
			opacity: 0.6;
		}
		96%, 97% {
			opacity: 0.85;
		}
	}
	.tagline {
		color: var(--neon-pink);
		font-size: 1.15em;
		font-weight: 700;
		letter-spacing: 0.05em;
		margin: 0.6em 0 1em;
		text-shadow: var(--glow-pink);
	}
	.bio {
		color: rgb(var(--gray));
	}
	.posts h2 {
		font-size: 1.5em;
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.4em;
	}
	.posts ul {
		list-style: none;
		padding: 0;
	}
	.posts li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		padding: 0.6em 0;
		border-bottom: 1px dashed var(--border);
	}
	.posts a {
		color: rgb(var(--gray-dark));
		text-decoration: none;
	}
	.posts a:hover {
		color: var(--accent);
		text-shadow: var(--glow-cyan);
	}
	.date {
		color: rgb(var(--gray));
		font-size: 0.85em;
		white-space: nowrap;
	}
	.all-posts {
		margin-top: 1.2em;
	}
</style>

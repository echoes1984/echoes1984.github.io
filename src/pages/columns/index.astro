---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = await getCollection('blog');
const columns = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags ?? []) {
		columns.set(tag, (columns.get(tag) ?? 0) + 1);
	}
}
const sorted = [...columns.entries()].sort((a, b) => b[1] - a[1]);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`专栏 | ${SITE_TITLE}`} description="按主题归类的文章专栏" />
	</head>
	<body>
		<Header />
		<main>
			<h1>专栏</h1>
			<p class="desc">按主题归类的系列文章。在文章 frontmatter 的 <code>tags</code> 里写上专栏名即可自动归入。</p>
			<ul class="columns">
				{
					sorted.map(([name, count]) => (
						<li>
							<a href={`/columns/${name}/`}>
								<span class="name">{name}</span>
								<span class="count">{count} 篇</span>
							</a>
						</li>
					))
				}
			</ul>
			{
				sorted.length === 0 && (
					<p>还没有专栏。写文章时在 frontmatter 加上 <code>tags: ["专栏名"]</code> 就会出现。</p>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	h1 {
		margin-bottom: 0.3em;
	}
	.desc {
		color: rgb(var(--gray));
	}
	.columns {
		list-style: none;
		padding: 0;
	}
	.columns a {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		padding: 0.8em 0.2em;
		border-bottom: 1px dashed rgb(var(--gray-light));
		text-decoration: none;
		color: rgb(var(--gray-dark));
	}
	.columns a:hover .name {
		color: var(--accent);
	}
	.count {
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
</style>

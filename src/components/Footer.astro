---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE} · 由
	<a href="https://astro.build" target="_blank">Astro</a> 驱动 ·
	<a href="/rss.xml">RSS</a> ·
	<a href="https://github.com/echoes1984" target="_blank">GitHub</a>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(to top, rgba(255, 46, 151, 0.05), transparent);
		color: rgb(var(--gray));
		text-align: center;
		border-top: 1px solid var(--border);
	}
	footer a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	footer a:hover {
		color: var(--accent);
	}
</style>
